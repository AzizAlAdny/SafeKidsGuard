# ──────────────────────────────────────────────────────────
# Safe Kids Guard — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/safekidsguard
# For Docker Compose: postgresql+asyncpg://postgres:password@db:5432/safekidsguard

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker Compose: redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── WhatsApp Business API (Meta Cloud API) ────────────────
# Get from: https://developers.facebook.com/ → Your App → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_ACCESS_TOKEN=your_permanent_system_user_access_token_here
WA_VERIFY_TOKEN=your_webhook_verify_token_here  # any random string you choose
WA_API_VERSION=v21.0

# ── Firebase (FCM) ────────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── App Settings ──────────────────────────────────────────
APP_ENV=development   # development | production
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AI_CONFIDENCE_THRESHOLD=0.75   # Minimum confidence to block content (0.0–1.0)

# ── Supabase (optional — for direct Supabase client use) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
