# ──────────────────────────────────────────────────────────
# Safe Kids Guard — Environment Variables Template
# Copy this file to server/.env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git
# ──────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# Option 1: SQLite (Default — Zero-config async file database for local development)
DATABASE_URL=sqlite+aiosqlite:///./safekids_dev.db

# Option 2: PostgreSQL (Production / Docker Compose)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/safekidsguard
# For Docker Compose: DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/safekidsguard

# Option 3: XAMPP MySQL (Requires: pip install aiomysql)
# DATABASE_URL=mysql+aiomysql://root:@localhost:3306/safekidsguard

# ── Redis Cache (SHA-256 Classification Cache) ────────────
REDIS_URL=redis://localhost:6379/0
# For Docker Compose: REDIS_URL=redis://redis:6379/0

# ── JWT Authentication & Session Security ─────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application & CORS Settings ───────────────────────────
APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.102:3000"]

# ── Hybrid Arabic AI Moderation Engine ────────────────────
AI_CONFIDENCE_THRESHOLD=0.75
AI_ENABLE_TRANSFORMERS=false
ARABERT_MODEL_NAME=aubmindlab/bert-base-arabertv02
CAMELBERT_MODEL_NAME=CAMeL-Lab/bert-base-arabic-camelbert-da

# ── Firebase / Web Push (Optional) ────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── Supabase (Optional) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
